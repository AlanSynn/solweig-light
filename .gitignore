# Reports retain concise provenance, protocols, source snapshots, and summaries.
# Generated rasters, array dumps, compiled caches, and local environments stay
# local; reproduction prerequisites and limits are documented in
# docs/evidence_storage.md.
reports/**/*.tif
reports/**/*.tiff
reports/**/*.npy
reports/**/*.npz
reports/**/*.nbc
reports/**/*.nbi
reports/**/*.pstats
reports/**/*.dylib
reports/**/*.so
reports/**/*.whl
reports/**/*.zip
reports/**/*.tar
reports/**/*.tar.gz
reports/**/venv/
reports/**/.venv/
reports/**/__pycache__/
reports/**/.pytest_cache/
reports/**/jit/
reports/**/geometry_cache/
reports/**/.solweig-light/
reports/**/output_folder/
reports/**/processed_inputs/
reports/**/tmp_*/
reports/**/test_*current

